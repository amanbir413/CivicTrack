# Copy this to .env.production and replace both placeholders before deployment.
# Generate each secret in PowerShell with: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-random-hex-password
POSTGRES_DB=civic_platform
POSTGRES_USER=civic
APP_PORT=3000
ENABLE_DEMO_ACCOUNTS=false
