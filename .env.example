PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://civic:civic_dev_password@localhost:5432/civic_platform
# Public demo-only key so a local clone can start without generating a secret.
# Never use this value for a public/production deployment.
JWT_SECRET=civic-demo-only-public-signing-key-not-for-production-2026
ESCALATION_INTERVAL_MS=60000
# Optional Google Gemini AI triage. Without a key, local rules assign a reviewable fallback priority.
# Keep the API key private in .env; do not commit it or place it in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional local storage path; defaults to data/private-uploads (kept out of public static files).
# UPLOAD_DIR=
MEDIA_STORAGE_DRIVER=local
# For private Amazon S3 storage, set MEDIA_STORAGE_DRIVER=s3 and configure these values.
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# Optional custom endpoint (S3-compatible service) and path-style addressing.
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# Nearby suggestion defaults: 1 km and the previous 30 days.
DUPLICATE_RADIUS_METERS=1000
DUPLICATE_LOOKBACK_DAYS=30
# Local demo accounts are intentionally public and are created by Docker Compose.
# Do not use these accounts on a public or production deployment.
ENABLE_DEMO_ACCOUNTS=true
ENABLE_DEMO_REPORTS=true
DEMO_CITIZEN_EMAIL=testcitizen@gmail.com
DEMO_CITIZEN_PASSWORD=citizen12345
DEMO_OFFICER_EMAIL=testdepartment@gmail.com
DEMO_OFFICER_PASSWORD=department12345
DEMO_OFFICER_DEPARTMENT=roads
DEMO_WATER_OFFICER_EMAIL=testwater@gmail.com
DEMO_WATER_OFFICER_PASSWORD=department12345
DEMO_POWER_OFFICER_EMAIL=testpower@gmail.com
DEMO_POWER_OFFICER_PASSWORD=department12345
DEMO_SANITATION_OFFICER_EMAIL=testsanitation@gmail.com
DEMO_SANITATION_OFFICER_PASSWORD=department12345
DEMO_HORTICULTURE_OFFICER_EMAIL=testhorticulture@gmail.com
DEMO_HORTICULTURE_OFFICER_PASSWORD=department12345
DEMO_GENERAL_OFFICER_EMAIL=testgeneral@gmail.com
DEMO_GENERAL_OFFICER_PASSWORD=department12345
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
